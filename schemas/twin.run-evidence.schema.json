{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youxuanxue/twin/schemas/twin.run-evidence.schema.json",
  "title": "Twin run evidence",
  "type": "object",
  "required": ["schema_version", "run_id", "item_id", "request", "result", "evidence", "status"],
  "properties": {
    "schema_version": {"const": 1}, "run_id": {"type": "string", "minLength": 1}, "item_id": {"type": "string", "minLength": 1}, "request": {"type": "object", "maxProperties": 16, "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}, "result": {"type": "object", "maxProperties": 16, "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}, "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {"relative": {"type": "string"}, "sha256": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}, "metadata": {"type": "object", "maxProperties": 16, "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}}}}, "status": {"type": "string", "minLength": 1}, "metadata": {"type": "object", "maxProperties": 16, "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}
  }, "additionalProperties": false
}
