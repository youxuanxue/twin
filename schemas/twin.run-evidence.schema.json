{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youxuanxue/twin/schemas/twin.run-evidence.schema.json",
  "title": "Twin run evidence",
  "type": "object",
  "required": ["schema_version", "run_id", "item_id", "request", "result", "evidence", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "item_id": {"type": "string", "minLength": 1},
    "request": {"type": "object", "required": ["relative", "sha256", "bytes"], "additionalProperties": false, "properties": {"relative": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}},
    "result": {"type": "object", "required": ["relative", "sha256", "bytes"], "additionalProperties": false, "properties": {"relative": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["relative", "sha256", "bytes"], "additionalProperties": false, "properties": {"relative": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}},
    "status": {"type": "string", "enum": ["completed", "failed"]}
  },
  "additionalProperties": false
}
