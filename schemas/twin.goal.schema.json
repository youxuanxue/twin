{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youxuanxue/twin/schemas/twin.goal.schema.json",
  "title": "Twin goal",
  "type": "object",
  "required": ["schema_version", "id", "one_liner", "core_goal", "acceptance_criteria", "non_goals"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "one_liner": {"type": "string", "minLength": 1},
    "core_goal": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "items": {"type": "object", "required": ["id", "statement", "evidence_type"], "properties": {"id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "evidence_type": {"type": "string", "minLength": 1}, "metadata": {"type": "object", "maxProperties": 16, "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}}, "additionalProperties": false}},
    "non_goals": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
