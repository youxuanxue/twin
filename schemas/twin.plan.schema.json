{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youxuanxue/twin/schemas/twin.plan.schema.json",
  "title": "Twin plan",
  "type": "object",
  "required": ["schema_version", "goal_id", "items", "verification"],
  "properties": {
    "schema_version": {"const": 1},
    "goal_id": {"type": "string", "minLength": 1},
    "items": {"type": "array", "items": {"type": "object", "required": ["id", "deliverable", "scope", "covers_ac", "evidence_plan", "actual_evidence", "depends_on", "status", "next_action"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "deliverable": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "covers_ac": {"type": "array", "items": {"type": "string", "minLength": 1}}, "evidence_plan": {"type": "array", "items": {"type": "string", "minLength": 1}}, "actual_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}, "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}}, "status": {"type": "string", "enum": ["pending", "in_progress", "completed", "blocked", "deferred"]}, "next_action": {"type": "string", "minLength": 1}, "metadata": {"type": "object", "maxProperties": 16, "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}}}},
    "verification": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object", "maxProperties": 16, "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}
  },
  "additionalProperties": false
}
