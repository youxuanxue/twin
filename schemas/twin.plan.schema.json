{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youxuanxue/twin/schemas/twin.plan.schema.json",
  "title": "Twin plan",
  "type": "object",
  "required": ["schema_version", "goal_id", "items", "verification"],
  "properties": {
    "schema_version": {"const": 1},
    "goal_id": {"type": "string", "minLength": 1},
    "items": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {"id": {"type": "string"}, "deliverable": {"type": "string"}, "scope": {"type": "string"}, "covers_ac": {"type": "array", "items": {"type": "string"}}, "evidence_plan": {"type": "array", "items": {"type": "string"}}, "actual_evidence": {"type": "array", "items": {"type": "string"}}, "depends_on": {"type": "array", "items": {"type": "string"}}, "status": {"type": "string"}, "next_action": {"type": "string"}, "metadata": {"type": "object", "maxProperties": 16, "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}}}},
    "verification": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object", "maxProperties": 16, "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}
  },
  "additionalProperties": false
}
